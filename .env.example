# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# ─── For deploy script only (NEVER prefix with VITE_) ────────────────────────
# Vite would expose any VITE_* variable to the browser bundle.
# This key is used by `npm run deploy` locally only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── For the frontend (safe — only contract address, no secrets) ─────────────
# Auto-filled by `npm run deploy` after deployment
VITE_CONTRACT_ADDRESS=
