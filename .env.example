# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# Your private key for signing transactions (hex format, 0x prefix)
# WARNING: Keep this secret. Use a dedicated testnet wallet only.
VITE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract address on Bradbury testnet
# This is auto-filled by `npm run deploy`
VITE_CONTRACT_ADDRESS=

# Network (always testnet_bradbury for now)
VITE_NETWORK=testnet_bradbury
